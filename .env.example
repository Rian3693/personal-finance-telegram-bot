# Copy to .env and fill in your own values. Never commit .env.
# Every value below is a placeholder.

# --- Required -------------------------------------------------------------
# Token of YOUR bot, from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your own numeric Telegram user id. Only this user may use the bot,
# and scheduled messages (alerts, reminders, monthly summaries) are sent here.
TELEGRAM_CHAT_ID=your-telegram-user-id

# --- AI features (optional; each call is billed by the provider) -----------
# Claude: receipt scanning, earnings reports and predictions, /debrief, /spendingreview,
# /shouldisell's decision step.
ANTHROPIC_API_KEY=your-anthropic-api-key
# OpenAI: older analysis and summary commands.
OPENAI_API_KEY=your-openai-api-key
# Perplexity: the research step of /shouldisell.
PERPLEXITY_API_KEY=your-perplexity-api-key

# --- Market data (optional) ----------------------------------------------
# Finnhub: earnings calendar, company news, peers (free tier available).
FINNHUB_API_KEY=your-finnhub-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
NEWS_API_KEY=your-newsapi-key

# Reddit (used by the CLI's social-sentiment collector)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=stock-research-bot/1.0

# News check interval in minutes
NEWS_CHECK_INTERVAL=15
